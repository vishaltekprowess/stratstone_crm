<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Tree View                                                     -->
    <!-- ============================================================ -->
    <record id="view_ninetynine_acres_raw_log_tree" model="ir.ui.view">
        <field name="name">ninetynine.acres.raw.log.tree</field>
        <field name="model">ninetynine.acres.raw.log</field>
        <field name="arch" type="xml">
            <list string="99acres Raw Payloads" default_order="received_at desc">
                <field name="received_at"/>
                <field name="source_ip"/>
                <field name="content_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'"
                       decoration-info="state == 'new'"
                       decoration-danger="state == 'error'"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form View                                                     -->
    <!-- ============================================================ -->
    <record id="view_ninetynine_acres_raw_log_form" model="ir.ui.view">
        <field name="name">ninetynine.acres.raw.log.form</field>
        <field name="model">ninetynine.acres.raw.log</field>
        <field name="arch" type="xml">
            <form string="99acres Raw Payload" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,processed,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Request Metadata">
                            <field name="received_at"/>
                            <field name="http_method"/>
                            <field name="source_ip"/>
                            <field name="content_type"/>
                            <field name="user_agent"/>
                            <field name="request_url"/>
                        </group>
                        <group string="Processing">
                            <field name="state"/>
                            <field name="lead_id"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw JSON" name="raw_json">
                            <field name="raw_json" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                        -->
    <!-- ============================================================ -->
    <record id="action_ninetynine_acres_raw_log" model="ir.actions.act_window">
        <field name="name">99acres Raw Payloads</field>
        <field name="res_model">ninetynine.acres.raw.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_state': 'new'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No 99acres payloads received yet.
            </p>
            <p>
                Raw JSON payloads from the 99acres webhook will appear here
                once the integration starts sending data.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu (under CRM → Configuration)                              -->
    <!-- ============================================================ -->
    <menuitem id="menu_ninetynine_acres_raw_log"
              name="99acres Raw Payloads"
              parent="crm.crm_menu_config"
              action="action_ninetynine_acres_raw_log"
              sequence="100"/>

</odoo>

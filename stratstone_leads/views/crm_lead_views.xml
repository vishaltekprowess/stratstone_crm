<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_stratstone" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.stratstone</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Hide Won button -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Lost buttons -->
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Expected Closing label and field -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Rename Expected Revenue to Budget -->
            <xpath expr="//label[@for='expected_revenue']" position="attributes">
                <attribute name="string">Budget</attribute>
            </xpath>
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="string">Budget</attribute>
            </xpath>

            <!-- Add BHK and Possession fields -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="bhk" string="Preference"/>
                <field name="possession"/>
                <field name="location"/>
            </xpath>

            <!-- Extra Information: Add Lost Reason field -->
            <xpath expr="//page[@name='lead']//group[@name='Misc']" position="inside">
                <field name="lost_reason" placeholder="e.g. Already booked elsewhere, Not interested, etc."/>
            </xpath>
            <xpath expr="//page[@name='extra']//group[@name='categorization']" position="inside">
                <field name="lost_reason" placeholder="e.g. Already booked elsewhere, Not interested, etc."/>
            </xpath>
        </field>
    </record>

    <!-- List View Inheritance for Lost Reason -->
    <record id="crm_case_tree_view_oppor_inherit_stratstone" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.inherit.stratstone</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="lost_reason" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Inheritance for Group By BHK and Lost Reason -->
    <record id="crm_lead_view_search_inherit_stratstone" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.stratstone</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="bhk" string="BHK"/>
                <field name="lost_reason" string="Lost Reason"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="BHK" name="groupby_bhk" context="{'group_by': 'bhk'}"/>
                <filter string="Lost Reason" name="groupby_lost_reason" context="{'group_by': 'lost_reason'}"/>
            </xpath>
        </field>
    </record>

    <!-- Server Action in List/Form view: Backfill Lost Reason from Chatter -->
    <record id="action_server_backfill_lost_reasons" model="ir.actions.server">
        <field name="name">Backfill Lost Reason from Chatter</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_backfill_lost_reasons()
        </field>
    </record>
</odoo>

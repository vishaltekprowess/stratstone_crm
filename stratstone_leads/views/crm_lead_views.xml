<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_stratstone" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.stratstone</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Hide Won button -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Lost buttons -->
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Expected Closing label and field -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add BHK and Possession string fields -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="bhk" string="Preference"/>
                <field name="possession"/>
                <field name="location"/>
            </xpath>
        </field>
    </record>
</odoo>

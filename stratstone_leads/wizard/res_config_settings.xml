<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stratstone_leads_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stratstone.leads</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Stratstone Leads" string="Stratstone Leads" name="stratstone_leads">
                    <block title="Meta Lead Ads">
                        <setting id="stratstone_meta_leadads_page_id"
                                 help="Facebook Page ID that owns the Leadgen Forms.">
                            <field name="meta_leadads_page_id"/>
                        </setting>
                        <setting id="stratstone_meta_leadads_access_token"
                                 help="Long-lived Page access token for reading Lead Ads.">
                            <field name="meta_leadads_access_token" widget="password"/>
                        </setting>
                        <setting id="stratstone_meta_leadads_form_ids"
                                 help="Comma-separated Leadgen Form IDs to sync into CRM Leads.">
                            <field name="meta_leadads_form_ids"
                                   placeholder="(optional) 705986448913842,103976261614743,..."/>
                        </setting>
                        <div class="mt16 d-flex flex-wrap gap-2">
                            <button type="object"
                                    name="action_meta_leadads_sync_now"
                                    string="Sync Meta Leads Now"
                                    class="btn btn-primary">
                                <i class="fa fa-refresh me-1"/>
                                Sync Meta Leads Now
                            </button>
                            <button type="action"
                                    name="%(stratstone_leads.action_meta_leadads_fetch_wizard)d"
                                    string="Fetch Meta Leads (Date Range)"
                                    class="btn btn-outline-secondary">
                                <i class="fa fa-calendar me-1"/>
                                Fetch Meta Leads (Date Range)
                            </button>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings Action -->
    <record id="action_stratstone_leads_settings" model="ir.actions.act_window">
        <field name="name">Stratstone Leads Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'stratstone_leads'}</field>
    </record>

</odoo>

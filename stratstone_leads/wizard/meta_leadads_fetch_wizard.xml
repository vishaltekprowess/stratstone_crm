<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_meta_leadads_fetch_wizard_form" model="ir.ui.view">
        <field name="name">meta.leadads.fetch.wizard.form</field>
        <field name="model">meta.leadads.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Fetch Meta Leads">
                <group>
                    <field name="meta_page_id" placeholder="All Active Pages" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_fetch" type="object"
                            string="Fetch" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meta_leadads_fetch_wizard" model="ir.actions.act_window">
        <field name="name">Fetch Meta Leads</field>
        <field name="res_model">meta.leadads.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

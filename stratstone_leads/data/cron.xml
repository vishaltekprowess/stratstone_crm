<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron: Sync Meta Lead Ads into CRM (every 10 minutes) -->
    <record id="ir_cron_meta_leadads_sync_leads" model="ir.cron">
        <field name="name">Sync Meta Lead Ads into CRM</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_meta_leadads_sync_leads()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>

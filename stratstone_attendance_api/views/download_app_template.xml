<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="download_app_page" name="Stratstone Attendance Mobile App Download">
        <t t-call="web.layout">
            <t t-set="title">Download Stratstone Attendance App</t>
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <style>
                    :root {
                        --bg-gradient-start: #0f172a;
                        --bg-gradient-end: #1e1b4b;
                        --card-bg: rgba(30, 41, 59, 0.7);
                        --card-border: rgba(255, 255, 255, 0.1);
                        --text-primary: #f8fafc;
                        --text-secondary: #94a3b8;
                        --accent-blue: #38bdf8;
                        --accent-indigo: #6366f1;
                        --btn-play-bg: linear-gradient(135deg, #059669 0%, #10b981 100%);
                        --btn-apple-bg: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
                    }

                    * {
                        box-sizing: border-box;
                        margin: 0;
                        padding: 0;
                    }

                    body {
                        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                        background: radial-gradient(circle at top center, #1e293b 0%, #0f172a 100%);
                        color: var(--text-primary);
                        min-height: 100vh;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 2rem 1rem;
                    }

                    .download-container {
                        max-width: 720px;
                        width: 100%;
                        background: var(--card-bg);
                        backdrop-filter: blur(16px);
                        -webkit-backdrop-filter: blur(16px);
                        border: 1px solid var(--card-border);
                        border-radius: 24px;
                        padding: 3rem 2.5rem;
                        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
                        text-align: center;
                        animation: fadeIn 0.6s ease-out;
                    }

                    @keyframes fadeIn {
                        from { opacity: 0; transform: translateY(20px); }
                        to { opacity: 1; transform: translateY(0); }
                    }

                    .app-badge {
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        background: rgba(99, 102, 241, 0.15);
                        border: 1px solid rgba(99, 102, 241, 0.3);
                        color: var(--accent-blue);
                        font-size: 0.875rem;
                        font-weight: 500;
                        padding: 6px 16px;
                        border-radius: 100px;
                        margin-bottom: 1.5rem;
                    }

                    .hero-icon {
                        width: 80px;
                        height: 80px;
                        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                        border-radius: 20px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto 1.5rem auto;
                        box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
                        font-size: 2.5rem;
                        color: #ffffff;
                    }

                    h1 {
                        font-size: 2.25rem;
                        font-weight: 700;
                        line-height: 1.2;
                        letter-spacing: -0.02em;
                        margin-bottom: 0.75rem;
                        background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                    }

                    p.subtitle {
                        font-size: 1.05rem;
                        color: var(--text-secondary);
                        margin-bottom: 2.5rem;
                        line-height: 1.6;
                    }

                    .buttons-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                        gap: 1.25rem;
                        margin-bottom: 2.5rem;
                    }

                    .store-btn {
                        display: flex;
                        align-items: center;
                        gap: 16px;
                        padding: 1rem 1.5rem;
                        border-radius: 16px;
                        text-decoration: none;
                        color: #ffffff;
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
                        border: 1px solid rgba(255, 255, 255, 0.15);
                    }

                    .store-btn.playstore {
                        background: var(--btn-play-bg);
                    }

                    .store-btn.appstore {
                        background: var(--btn-apple-bg);
                    }

                    .store-btn:hover {
                        transform: translateY(-3px);
                        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
                        filter: brightness(1.1);
                        color: #ffffff;
                    }

                    .store-btn i {
                        font-size: 2.2rem;
                    }

                    .btn-text {
                        text-align: left;
                    }

                    .btn-text .caption {
                        font-size: 0.75rem;
                        text-transform: uppercase;
                        letter-spacing: 0.05em;
                        opacity: 0.85;
                    }

                    .btn-text .title {
                        font-size: 1.2rem;
                        font-weight: 600;
                    }

                    .disabled-btn {
                        opacity: 0.4;
                        cursor: not-allowed;
                        pointer-events: none;
                    }

                    .features-list {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                        gap: 1rem;
                        padding-top: 2rem;
                        border-top: 1px solid var(--card-border);
                        text-align: left;
                    }

                    .feature-item {
                        display: flex;
                        align-items: flex-start;
                        gap: 10px;
                        font-size: 0.9rem;
                        color: var(--text-secondary);
                    }

                    .feature-item i {
                        color: #10b981;
                        margin-top: 3px;
                    }

                    footer {
                        margin-top: 2rem;
                        font-size: 0.8rem;
                        color: rgba(148, 163, 184, 0.6);
                    }
                </style>
            </head>
            <body>
                <div class="download-container">
                    <div class="app-badge">
                        <i class="fas fa-location-dot"></i> Attendance Tracking Mobile App
                    </div>

                    <div class="hero-icon">
                        <i class="fas fa-user-clock"></i>
                    </div>

                    <h1>Get Stratstone Attendance App</h1>
                    <p class="subtitle">
                        Seamlessly check in, log your work hours, and track location data with the official Stratstone mobile app.
                    </p>

                    <div class="buttons-grid">
                        <!-- Android Store Button -->
                        <t t-if="playstore_url">
                            <a t-att-href="playstore_url" target="_blank" rel="noopener noreferrer" class="store-btn playstore">
                                <i class="fab fa-google-play"></i>
                                <div class="btn-text">
                                    <div class="caption">GET IT FOR</div>
                                    <div class="title">Android</div>
                                </div>
                            </a>
                        </t>
                        <t t-else="">
                            <div class="store-btn playstore disabled-btn" title="URL not configured yet">
                                <i class="fab fa-google-play"></i>
                                <div class="btn-text">
                                    <div class="caption">Android</div>
                                    <div class="title">Coming Soon</div>
                                </div>
                            </div>
                        </t>

                        <!-- Apple App Store Button -->
                        <t t-if="appstore_url">
                            <a t-att-href="appstore_url" target="_blank" rel="noopener noreferrer" class="store-btn appstore">
                                <i class="fab fa-apple"></i>
                                <div class="btn-text">
                                    <div class="caption">GET IT FOR</div>
                                    <div class="title">IOS</div>
                                </div>
                            </a>
                        </t>
                        <t t-else="">
                            <div class="store-btn appstore disabled-btn" title="URL not configured yet">
                                <i class="fab fa-apple"></i>
                                <div class="btn-text">
                                    <div class="caption">IOS</div>
                                    <div class="title">Coming Soon</div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="features-list">
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>GPS Location Check-in &amp; Check-out</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Real-time Attendance History</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Automated Notifications &amp; Alerts</span>
                        </div>
                    </div>

                    <footer>
                        &amp;copy; Stratstone. All rights reserved.
                    </footer>
                </div>
            </body>
        </t>
    </template>

</odoo>

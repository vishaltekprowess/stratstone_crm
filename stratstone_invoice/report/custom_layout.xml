<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         STRATSTONE REALTY HEADER LAYOUT (Hybrid Luxury Boxed Style)
         Clean corporate header with Logo, Company Details & Document Title
         ===================================================================== -->
    <template id="stratstone_header_layout">
        <t t-set="company" t-value="company or (o and o.company_id) or (doc and doc.company_id) or env.company"/>
        <t t-set="comp" t-value="company"/>
        <t t-set="res_company" t-value="comp.company_id if 'company_id' in comp and comp.company_id else comp"/>
        <t t-set="partner" t-value="comp.partner_id if 'partner_id' in comp and comp.partner_id else (res_company.partner_id if 'partner_id' in res_company else False)"/>

        <div t-attf-class="header {{report_type != 'pdf' and 'h-0'}}" style="position: relative; width: 100%; margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; overflow: hidden; background-color: #ffffff;">
            <style>
                * {
                    font-family: Arial, Helvetica, "Nimbus Sans L", sans-serif !important;
                }
                body.container,
                .container {
                    max-width: 100% !important;
                    width: 100% !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .header {
                    margin: 0 !important;
                    padding: 0 !important;
                    top: 0 !important;
                    left: 0 !important;
                    right: 0 !important;
                    width: 100% !important;
                }
                .header table,
                .header tr,
                .header td {
                    border: none !important;
                    border-collapse: separate !important;
                    border-spacing: 0 !important;
                }
            </style>

            <!-- Subtle Luxury Background Graphic: Soft Architectural Wave (Full-Width)
                 Pure vector SVG - zero rasterization in wkhtmltopdf PDF output.
                 Uses solid fill-opacity layers only (no linearGradient) to avoid
                 wkhtmltopdf 0.12.6 bug that rasterizes SVG gradient fills to images.
                 Both layers close at y=150 on the left so the full company address
                 is covered. No hairline border. -->
            <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none;"
                 viewBox="0 0 794 150" preserveAspectRatio="none"
                 xmlns="http://www.w3.org/2000/svg">
                <!-- Layer 1: lightest warm champagne - full left-to-right sweep, closes at bottom-left -->
                <path d="M0,0 L794,0 L794,78 C650,128 500,148 360,122 C220,96 110,118 0,150 Z"
                      fill="#f9f4ed" fill-opacity="0.70"/>
                <!-- Layer 2: slightly warmer inner sweep, also closes at bottom-left -->
                <path d="M0,0 L794,0 L794,55 C680,98 540,118 400,100 C260,80 120,100 0,150 Z"
                      fill="#f2e9d8" fill-opacity="0.45"/>
            </svg>

            <!-- Top Header Grid: Company Logo & Details (Left) + Document Title (Right) -->
            <div style="position: relative; z-index: 2; padding: 5mm 12mm 2mm 12mm;">
                <table style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: none !important;">
                    <tbody>
                        <tr style="border: none !important;">
                            <!-- Top-Left: Logo & Company Name/Address -->
                            <td style="width: 55%; vertical-align: top; padding: 0; border: none !important;">
                                <div style="margin-bottom: 4px;">
                                    <img t-if="comp.logo"
                                         class="o_company_logo"
                                         t-att-src="image_data_uri(comp.logo)"
                                         alt="Stratstone"
                                         style="max-height: 48px; max-width: 220px; object-fit: contain;" />
                                    <h2 t-else="" style="margin: 0; color: #a5824c; font-weight: bold; font-size: 20px;">
                                        <span t-esc="comp.name or 'STRATSTONE REALTY'"/>
                                    </h2>
                                </div>
                                <div style="font-weight: 700; color: #111827; font-size: 13.5px; margin-bottom: 2px;">
                                    <span t-esc="comp.name or 'STRATSTONE REALTY PRIVATE LIMITED'"/>
                                </div>
                                <t t-if="comp.company_details">
                                    <div t-field="comp.company_details" style="font-size: 11px; color: #4b5563; line-height: 1.4;"/>
                                </t>
                                <t t-elif="partner">
                                    <div style="font-size: 11px; color: #4b5563; line-height: 1.4;">
                                        <span t-if="partner.street" t-esc="partner.street"/><span t-if="partner.street2">, <span t-esc="partner.street2"/></span>
                                        <span t-if="partner.city">, <span t-esc="partner.city"/></span>
                                        <span t-if="partner.state_id">, <span t-esc="partner.state_id.name"/></span>
                                        <span t-if="partner.zip"> - <span t-esc="partner.zip"/></span>
                                    </div>
                                    <div style="font-size: 11px; color: #4b5563; line-height: 1.4; margin-top: 1px;">
                                        <span t-if="comp.vat"><strong>GSTIN:</strong> <span t-esc="comp.vat"/></span>
                                        <span t-if="partner.state_id"> | <strong>State Code:</strong> <span t-esc="partner.state_id.code"/></span>
                                    </div>
                                    <div t-if="comp.phone or comp.email" style="font-size: 10.5px; color: #6b7280; margin-top: 1px;">
                                        <span t-if="comp.phone">Tel: <span t-esc="comp.phone"/></span>
                                        <span t-if="comp.email"> | <span t-esc="comp.email"/></span>
                                    </div>
                                </t>
                            </td>

                            <!-- Top-Right: Prominent Tax Invoice Title & Doc Number -->
                            <td style="width: 45%; vertical-align: top; text-align: right; padding: 0; border: none !important;">
                                <div style="font-size: 26px; font-weight: 800; color: #a5824c; line-height: 1.1; text-transform: uppercase; letter-spacing: 0.04em;">
                                    <t t-if="o and o._name == 'sale.order'">
                                        <t t-if="env.context.get('proforma', False) or is_pro_forma">Proforma Invoice</t>
                                        <t t-elif="o.state in ('draft', 'sent')">Quotation</t>
                                        <t t-else="">Sales Order</t>
                                    </t>
                                    <t t-elif="o and o._name == 'account.move'">
                                        <t t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</t>
                                        <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</t>
                                        <t t-elif="o.move_type == 'out_refund'">Credit Note</t>
                                        <t t-elif="o.move_type == 'in_refund'">Vendor Credit Note</t>
                                        <t t-elif="o.move_type == 'in_invoice'">Vendor Bill</t>
                                        <t t-elif="o.move_type == 'out_invoice'">
                                            <t t-if="o.amount_tax">Tax Invoice</t>
                                            <t t-else="">Bill of Supply</t>
                                        </t>
                                        <t t-else="">Tax Invoice</t>
                                    </t>
                                    <t t-else="">Tax Invoice</t>
                                </div>
                                <div t-if="o and 'name' in o and o.name and o.name != '/'" style="font-size: 14px; font-weight: 700; color: #1f2937; margin-top: 4px;">
                                    # <span t-field="o.name"/>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </template>

    <!-- =====================================================================
         STRATSTONE REALTY CLIENT & TITLE LAYOUT (Hybrid Boxed Structure)
         Structured 2-Card Metadata Grid & Billing / Shipping Box (Design 1)
         ===================================================================== -->
    <template id="stratstone_address_layout">
        <t t-set="company" t-value="company or (o and o.company_id) or (doc and doc.company_id) or env.company"/>
        <t t-set="comp" t-value="company"/>

        <!-- ══════════════════════════════════════════════════════════════
             CARD 1: INVOICE METADATA GRID (Structured 2-Column Table)
             ══════════════════════════════════════════════════════════════ -->
        <table style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 1px solid #dcd7ce !important; margin-top: 4px; margin-bottom: 10px; font-family: Arial, Helvetica, sans-serif; background-color: #ffffff;">
            <tr>
                <!-- Left Sub-Box: Invoice#, Invoice Date, Terms, Due Date -->
                <td style="width: 50%; vertical-align: top; padding: 8px 12px; border: none !important; border-right: 1px solid #dcd7ce !important;">
                    <table style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: none !important;">
                        <tr style="border: none !important;">
                            <td style="width: 40%; font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Invoice#:</td>
                            <td style="width: 60%; font-size: 11.5px; color: #111827; font-weight: 700; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'name' in o and o.name and o.name != '/'" t-field="o.name"/>
                                <span t-else="">INV/2026/0001</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Invoice Date:</td>
                            <td style="font-size: 11.5px; color: #111827; font-weight: 700; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'invoice_date' in o and o.invoice_date" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                <span t-elif="o and 'date_order' in o and o.date_order" t-esc="o.date_order.strftime('%d/%m/%Y')"/>
                                <span t-else="">17/11/2026</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Terms:</td>
                            <td style="font-size: 11px; color: #111827; font-weight: 600; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'invoice_payment_term_id' in o and o.invoice_payment_term_id" t-field="o.invoice_payment_term_id.name"/>
                                <span t-else="">Due on Receipt</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Due Date:</td>
                            <td style="font-size: 11.5px; color: #111827; font-weight: 700; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'invoice_date_due' in o and o.invoice_date_due" t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
                                <span t-elif="o and 'invoice_date' in o and o.invoice_date" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                <span t-else="">17/11/2026</span>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- Right Sub-Box: Place of Supply, State Code, GSTIN, Reference -->
                <td style="width: 50%; vertical-align: top; padding: 8px 12px; border: none !important;">
                    <table style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: none !important;">
                        <tr style="border: none !important;">
                            <td style="width: 42%; font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Place of Supply:</td>
                            <td style="width: 58%; font-size: 11.5px; color: #111827; font-weight: 700; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'l10n_in_state_id' in o and o.l10n_in_state_id">
                                    <span t-field="o.l10n_in_state_id.name"/>
                                    <span t-if="o.l10n_in_state_id.code"> (<span t-field="o.l10n_in_state_id.code"/>)</span>
                                </span>
                                <span t-elif="o and o.partner_id and o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id.name"/>
                                    <span t-if="o.partner_id.state_id.code"> (<span t-field="o.partner_id.state_id.code"/>)</span>
                                </span>
                                <span t-else="">—</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Customer GSTIN:</td>
                            <td style="font-size: 11.5px; color: #111827; font-weight: 700; padding: 2px 0; border: none !important;">
                                <span t-if="o and o.partner_id and o.partner_id.vat" t-field="o.partner_id.vat"/>
                                <span t-else="">—</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Reference:</td>
                            <td style="font-size: 11px; color: #111827; font-weight: 600; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'ref' in o and o.ref" t-field="o.ref"/>
                                <span t-elif="o and 'invoice_origin' in o and o.invoice_origin" t-field="o.invoice_origin"/>
                                <span t-else="">—</span>
                            </td>
                        </tr>
                        <tr style="border: none !important;">
                            <td style="font-size: 11px; color: #64748b; font-weight: 600; padding: 2px 0; border: none !important;">Reverse Charge:</td>
                            <td style="font-size: 11px; color: #111827; font-weight: 600; padding: 2px 0; border: none !important;">
                                <span t-if="o and 'invoice_line_ids' in o and any(t.l10n_in_reverse_charge for t in o.invoice_line_ids.tax_ids)">Yes</span>
                                <span t-else="">No</span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- ══════════════════════════════════════════════════════════════
             CARD 2: BILL TO & SHIP TO / DISPATCH BOX (Structured Grid)
             ══════════════════════════════════════════════════════════════ -->
        <table style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 1px solid #dcd7ce !important; margin-bottom: 14px; font-family: Arial, Helvetica, sans-serif; background-color: #ffffff;">
            <!-- Header Strip -->
            <tr style="background-color: #f7f5f1;">
                <td style="width: 50%; padding: 6px 12px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; color: #a5824c; letter-spacing: 0.05em; border: none !important; border-right: 1px solid #dcd7ce !important; border-bottom: 1px solid #dcd7ce !important;">
                    Bill To
                </td>
                <td style="width: 50%; padding: 6px 12px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; color: #a5824c; letter-spacing: 0.05em; border: none !important; border-bottom: 1px solid #dcd7ce !important;">
                    Ship To / Dispatch
                </td>
            </tr>
            <!-- Details Row -->
            <tr>
                <!-- Bill To Client Details -->
                <td style="width: 50%; vertical-align: top; padding: 10px 12px; border: none !important; border-right: 1px solid #dcd7ce !important; font-size: 11.5px; color: #374151; line-height: 1.45;">
                    <t t-if="address">
                        <div t-out="address"/>
                    </t>
                    <t t-elif="o and 'partner_id' in o and o.partner_id">
                        <div style="font-size: 13.5px; font-weight: 700; color: #111827; margin-bottom: 3px;">
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div t-if="o.partner_id.street or o.partner_id.street2">
                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><span t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></span>
                        </div>
                        <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">
                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/><span t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></span><span t-if="o.partner_id.zip"> - <span t-field="o.partner_id.zip"/></span>
                        </div>
                        <div t-if="o.partner_id.country_id">
                            <span t-field="o.partner_id.country_id.name"/>
                        </div>
                        <div t-if="o.partner_id.vat" style="margin-top: 3px; font-size: 11px; color: #111827;">
                            <strong>GSTIN:</strong> <span t-field="o.partner_id.vat"/>
                        </div>
                        <div t-if="o.partner_id.phone or o.partner_id.email" style="font-size: 10.5px; color: #6b7280; margin-top: 2px;">
                            <span t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/></span>
                            <span t-if="o.partner_id.email"> | <span t-field="o.partner_id.email"/></span>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 13.5px; font-weight: 700; color: #111827; margin-bottom: 3px;">
                            Customer Name
                        </div>
                        <div>Address Details</div>
                    </t>
                </td>

                <!-- Ship To Details -->
                <td style="width: 50%; vertical-align: top; padding: 10px 12px; border: none !important; font-size: 11.5px; color: #374151; line-height: 1.45;">
                    <t t-if="o and o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                        <div style="font-size: 13.5px; font-weight: 700; color: #111827; margin-bottom: 3px;">
                            <span t-field="o.partner_shipping_id.name"/>
                        </div>
                        <div t-if="o.partner_shipping_id.street or o.partner_shipping_id.street2">
                            <span t-if="o.partner_shipping_id.street" t-field="o.partner_shipping_id.street"/><span t-if="o.partner_shipping_id.street2">, <span t-field="o.partner_shipping_id.street2"/></span>
                        </div>
                        <div t-if="o.partner_shipping_id.city or o.partner_shipping_id.state_id or o.partner_shipping_id.zip">
                            <span t-if="o.partner_shipping_id.city" t-field="o.partner_shipping_id.city"/><span t-if="o.partner_shipping_id.state_id">, <span t-field="o.partner_shipping_id.state_id.name"/></span><span t-if="o.partner_shipping_id.zip"> - <span t-field="o.partner_shipping_id.zip"/></span>
                        </div>
                        <div t-if="o.partner_shipping_id.country_id">
                            <span t-field="o.partner_shipping_id.country_id.name"/>
                        </div>
                    </t>
                    <t t-elif="o and 'partner_id' in o and o.partner_id">
                        <div style="font-size: 13.5px; font-weight: 700; color: #111827; margin-bottom: 3px;">
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div style="color: #64748b; font-style: italic; margin-bottom: 4px;">
                            Same as Billing Address
                        </div>
                        <div t-if="'l10n_in_state_id' in o and o.l10n_in_state_id" style="font-size: 11px; color: #4b5563;">
                            <strong>Place of Supply:</strong> <span t-field="o.l10n_in_state_id.name"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="color: #64748b; font-style: italic;">
                            Same as Billing Address
                        </div>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <!-- =====================================================================
         STRATSTONE REALTY FOOTER LAYOUT
         Parsed by wkhtmltopdf into footer.html (pins to bottom margin)
         ===================================================================== -->
    <template id="stratstone_footer_layout">
        <t t-set="company" t-value="company or (o and o.company_id) or (doc and doc.company_id) or env.company"/>
        <t t-set="comp" t-value="company"/>
        <t t-set="res_company" t-value="comp.company_id if 'company_id' in comp and comp.company_id else comp"/>
        <div t-attf-class="footer o_standard_footer {{report_type != 'pdf' and 'position-relative mt-auto mx-n5'}}"
             style="font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; color: #6b7280; border-top: 1px solid #dcd7ce; padding-top: 5px; padding-left: 12mm; padding-right: 12mm; line-height: 1.45;">
            <style>
                * {
                    font-family: Arial, Helvetica, "Nimbus Sans L", sans-serif !important;
                }
            </style>
            <div style="text-align: center; margin-bottom: 2px; font-style: italic; color: #78716c;">
                Thank you for choosing <span t-esc="comp.name or res_company.name or 'Stratstone Realty'"/>. For any inquiries, please contact <span t-esc="comp.email if ('email' in comp and comp.email) else (res_company.email if 'email' in res_company and res_company.email else '')"/> or call <span t-esc="comp.phone if ('phone' in comp and comp.phone) else (res_company.phone if 'phone' in res_company and res_company.phone else '')"/>.
            </div>
            <div class="row" style="font-size: 10px; color: #4b5563; border-top: 1px solid #f2efe9; padding-top: 2px;">
                <div class="col-8 text-start">
                    <span t-if="'name' in comp and comp.name" t-esc="comp.name" style="font-weight: bold; color: #111827;"/>
                    <span t-elif="'name' in res_company and res_company.name" t-esc="res_company.name" style="font-weight: bold; color: #111827;"/>
                    <span t-if="'vat' in comp and comp.vat"> | GSTIN: <span t-esc="comp.vat"/></span>
                    <span t-elif="'vat' in res_company and res_company.vat"> | GSTIN: <span t-esc="res_company.vat"/></span>
                    <span t-if="'company_registry' in res_company and res_company.company_registry"> | CIN: <span t-esc="res_company.company_registry"/></span>
                    <span t-if="'website' in comp and comp.website"> | Web: <span t-esc="comp.website"/></span>
                    <span t-elif="'website' in res_company and res_company.website"> | Web: <span t-esc="res_company.website"/></span>
                </div>
                <div class="col-4 text-end">
                    <span t-if="report_type == 'pdf'">
                        Page <span class="page"/> of <span class="topage"/>
                    </span>
                </div>
            </div>
        </div>
    </template>

    <!-- Base Layout -->
    <template id="stratstone_base_layout">
        <t t-out="0" />
    </template>

    <!-- =====================================================================
         FULL DOCUMENT LAYOUT WRAPPER (Used by web.external_layout)
         Properly splits into header, article, and footer for wkhtmltopdf & preview
         ===================================================================== -->
    <template id="stratstone_custom_layout">
        <t t-set="company" t-value="company or (o and o.company_id) or (doc and doc.company_id) or env.company"/>
        <t t-set="comp" t-value="company"/>
        <t t-call="stratstone_invoice.stratstone_base_layout">
            <style>
                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-family: Arial, Helvetica, "Nimbus Sans L", sans-serif !important;
                }
                .header {
                    margin: 0 !important;
                    padding: 0 !important;
                    top: 0 !important;
                    left: 0 !important;
                    right: 0 !important;
                    width: 100% !important;
                }
                .stratstone-invoice,
                .stratstone-invoice * {
                    font-family: Arial, Helvetica, "Nimbus Sans L", sans-serif !important;
                }
                .stratstone-invoice {
                    color: #1f2937;
                    font-size: 12px;
                    line-height: 1.5;
                    background: #ffffff;
                    box-sizing: border-box;
                    padding: 0 12mm !important;
                    margin: 0 !important;
                }
                .stratstone-invoice .page > #informations {
                    display: none !important;
                }
                /* Prevent wkhtmltopdf default black table border collapse bug */
                .stratstone-invoice table {
                    border-collapse: separate !important;
                    border-spacing: 0 !important;
                }
                .stratstone-invoice table,
                .stratstone-invoice thead,
                .stratstone-invoice tbody,
                .stratstone-invoice tr,
                .stratstone-invoice th,
                .stratstone-invoice td {
                    border-color: transparent;
                }
                .header table,
                .header tr,
                .header td {
                    border: none !important;
                    border-color: transparent !important;
                }
            </style>

            <!-- 1. Header (parsed to header.html by wkhtmltopdf; sits at top in preview) -->
            <t t-call="stratstone_invoice.stratstone_header_layout" />

            <!-- 2. Body Article (starts below header) -->
            <div t-attf-class="article o_stratstone_report_custom stratstone-invoice"
                t-attf-style="{{report_type != 'pdf' and 'margin-top: 155px;' or ''}}"
                t-att-data-oe-model="o and o._name"
                t-att-data-oe-id="o and o.id"
                t-att-data-oe-lang="en_US">
                <t t-call="stratstone_invoice.stratstone_address_layout" />
                <div class="stratstone-body" style="padding: 0;">
                    <t t-out="0" />
                </div>
            </div>

            <!-- 3. Footer (parsed to footer.html by wkhtmltopdf; pins to bottom in preview) -->
            <t t-call="stratstone_invoice.stratstone_footer_layout" />
        </t>
    </template>

    <!-- =====================================================================
         LAYOUT RECORD SEEN IN "Configure your document layout"
